        },
        {
            "type": "continuum_i_alpha",
            "stokes_i": "configs/fits_model/generated/mm_target_a_i.fits",
            "alpha": "configs/fits_model/generated/mm_target_a_alpha.fits",
            "reference_frequency_hz": 1455500000.0
        },
        {
            "type": "continuum_i_alpha",
            "stokes_i": "configs/fits_model/generated/mm_target_b_i.fits",
            "alpha": "configs/fits_model/generated/mm_target_b_alpha.fits",
            "reference_frequency_hz": 1455500000.0
        }
    ],
    "center": "15h31m25.36s 35d33m40.2s",
    "observation": {
        "frequency_mhz": 1455.5,
        "bandwidth_mhz": 8.0,
        "n_channels": 16,
        "observation_time_s": 600
    },
    "uv_coverage": false,
    "imaging": [
        {
