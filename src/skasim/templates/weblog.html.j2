<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>weblog — {{ manifest.run_id }}</title>
  <style>
    :root {
      --fg: #24292f;
      --muted: #656d76;
      --border: #d8dee4;
      --accent: #0969da;
      --success: #1a7f37;
      --danger: #cf222e;
      --warning: #9a6700;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; color: var(--fg); line-height: 1.5; }
    .container { max-width: 1300px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { font-size: 1.5rem; font-weight: 600; }
    h2 { font-size: 1.1rem; font-weight: 600; margin: 2.2rem 0 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* header */
    .header { margin-bottom: 1.5rem; }
    .header .meta { color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem; }
    .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; vertical-align: middle; margin-left: 0.5rem; }
    .badge.success { background: rgba(63,185,80,0.15); color: var(--success); }
    .badge.danger  { background: rgba(248,81,73,0.15); color: var(--danger); }
    .badge.running { background: rgba(88,166,255,0.15); color: var(--accent); }
    /* sky model input type badges */
    .badge.catalog { background: rgba(26,127,55,0.13); color: #1a7f37; }
    .badge.fits-catalog { background: rgba(45,164,78,0.13); color: #2da44e; }
    .badge.continuum { background: rgba(9,105,218,0.13); color: #0969da; }
    .badge.taylor { background: rgba(130,80,223,0.13); color: #8250df; }
    .badge.stokes-maps { background: rgba(188,76,0,0.13); color: #bc4c00; }
    .badge.fits-file { background: rgba(0,129,138,0.13); color: #00818a; }
    .badge.random { background: rgba(101,109,118,0.13); color: var(--muted); }
    .badge.spectral-cube { background: rgba(183,33,117,0.13); color: #b72175; }

    /* top-of-report summary card */
    .summary-card { border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; background: #fbfbfc; }
    .summary-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .summary-title { font-size: 1.05rem; font-weight: 500; margin-top: 0.5rem; }
    .summary-description { color: var(--muted); font-size: 0.9rem; margin-top: 0.2rem; line-height: 1.4; }
    .summary-status-chip { font-size: 0.78rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 999px; white-space: nowrap; }
    .summary-status-chip.chip-ok { background: rgba(26,127,55,0.12); color: var(--success); }
    .summary-status-chip.chip-warn { background: rgba(191,135,0,0.14); color: var(--warning); }
    .summary-stats { display: flex; gap: 2rem; flex-wrap: wrap; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
    .summary-stat-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.25rem; }
    .summary-stat-value { font-size: 0.88rem; font-variant-numeric: tabular-nums; }
    .summary-stat-value .badge { margin-left: 0; margin-right: 0.3rem; }
    .summary-invocation { margin-top: 0.75rem; }
    .summary-invocation code { font-size: 0.78rem; color: var(--muted); word-break: break-all; }

    /* warnings banner */
    .warning-banner { background: rgba(191,135,0,0.10); border: 1px solid rgba(191,135,0,0.35); border-radius: 6px; padding: 0.75rem 1rem; margin: 1rem 0 0; font-size: 0.85rem; }
    .warning-banner .warning-title { color: var(--warning); font-weight: 600; margin-bottom: 0.35rem; }
    .warning-banner ul { margin: 0; padding-left: 1.2rem; }
    .warning-banner li { margin: 0.15rem 0; }

    /* durations summary */
    .durations-summary { display: flex; gap: 2rem; margin: 1.5rem 0; font-size: 0.85rem; color: var(--muted); }
    .durations-summary h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem; }

    /* config table */
    .config-row { display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap; }
    .config-row table { border-collapse: collapse; font-size: 0.85rem; flex: 1; min-width: 320px; }
    .config-row th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.25rem 1rem 0.25rem 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 190px; }
    .config-row td { padding: 0.25rem 1rem 0.25rem 0; font-variant-numeric: tabular-nums; }
    .config-row .plot-container { flex-shrink: 0; text-align: center; }
    .config-row .plot-container img { height: 260px; width: auto; display: block; }
    .config-row .plot-title { font-size: 0.75rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; margin-bottom: 0.5rem; text-align: left; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem 2rem; }
    .info-grid table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .info-grid th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.25rem 1rem 0.25rem 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 190px; }
    .info-grid td { padding: 0.25rem 1rem 0.25rem 0; font-variant-numeric: tabular-nums; }
    .section-label { font-size: 0.78rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; margin-bottom: 0.35rem; }

    /* science images */
    .science-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 0.75rem; }
    .science-grid figure { margin: 0; text-align: center; }
    .science-grid img { width: 100%; height: auto; display: block; }
    .science-grid figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }
    .stats-line { font-size: 0.85rem; color: var(--muted); margin-top: 0.5rem; font-variant-numeric: tabular-nums; }
    .psf-profile { margin-top: 1rem; border: 1px solid var(--border); border-radius: 8px; padding: 1rem; background: #fafbfc; }
    .psf-profile .psf-layout { display: grid; grid-template-columns: minmax(280px, 1.5fr) minmax(220px, 1fr); gap: 1.5rem; align-items: start; }
    .psf-profile img { width: 100%; max-width: 520px; height: auto; display: block; border-radius: 4px; border: 1px solid var(--border); }
    .psf-profile table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .psf-profile th { text-align: left; width: 120px; color: var(--muted); font-weight: 500; padding: 0.3rem 0.5rem 0.3rem 0; border-bottom: 1px solid #eee; }
    .psf-profile td { padding: 0.3rem 0; border-bottom: 1px solid #eee; font-variant-numeric: tabular-nums; }
    @media (max-width: 700px) { .psf-profile .psf-layout { grid-template-columns: 1fr; } }

    /* sky composition (multimodal runs) */
    .composition { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 460px); gap: 1.5rem; align-items: start; margin-top: 1.25rem; }
    @media (max-width: 900px) { .composition { grid-template-columns: 1fr; } }
    .composition img { width: 100%; height: auto; display: block; }
    table.composition-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    table.composition-table th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.3rem 0.6rem; border-bottom: 1px solid var(--border); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
    table.composition-table td { padding: 0.35rem 0.6rem; border-bottom: 1px solid #f0f0f0; vertical-align: baseline; }
    table.composition-table tr:last-child td { border-bottom: none; }
    table.composition-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    table.composition-table .src { font-family: monospace; font-size: 0.75rem; color: var(--muted); word-break: break-all; }
    .composition-notes { display: grid; grid-template-columns: max-content 1fr; gap: 0.2rem 1rem; font-size: 0.8rem; margin-top: 0.9rem; }
    .composition-notes dt { color: var(--muted); text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; padding-top: 0.1rem; }
    .composition-notes dd { margin: 0; font-variant-numeric: tabular-nums; }
    .flag { color: var(--danger); font-size: 0.75rem; margin-left: 0.25rem; }

    /* timeline */
    table.timeline { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    table.timeline th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--border); font-size: 0.75rem; text-transform: uppercase; }
    table.timeline td { padding: 0.3rem 0.5rem; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
    table.timeline tr:last-child td { border-bottom: none; }
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 0.3rem; vertical-align: middle; }
    .dot-completed { background: var(--success); }
    .dot-started   { background: var(--accent); }
    .dot-failed    { background: var(--danger); }

    /* supporting gallery */
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.75rem; margin-top: 0.75rem; }
    .gallery figure { margin: 0; }
    .gallery img { width: 100%; height: auto; display: block; }
    .gallery figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }

    /* details / config dump */
    details { margin-top: 1.5rem; }
    details summary { cursor: pointer; font-weight: 600; font-size: 1.1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
    details pre { background: #f6f8fa; padding: 1rem; overflow-x: auto; font-size: 0.78rem; font-family: "SF Mono", "Fira Code", monospace; border-radius: 6px; margin-top: 0.75rem; }
    details table { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 0.75rem; }
    details th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--border); font-size: 0.75rem; }
    details td { padding: 0.3rem 0.5rem; border-bottom: 1px solid #f0f0f0; }

    @media (max-width: 700px) {
      .science-grid { grid-template-columns: 1fr; }
      .config-row { flex-direction: column; }
    }

    /* tab navigation for batch imaging */
    .tab-buttons { display: flex; gap: 0.5rem; margin: 0.5rem 0 0; border-bottom: 1px solid var(--border); }
    .tab-button { background: none; border: none; padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 500; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; }
    .tab-button:hover { color: var(--fg); }
    .tab-button.active { color: var(--accent); border-bottom-color: var(--accent); }
    .tab-panel { display: none; margin-top: 0.75rem; }
    .tab-panel.active { display: block; }
  </style>
  <script>
    function showTab(tag) {
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      document.querySelectorAll('.tab-button').forEach(function(b) { b.classList.remove('active'); });
      document.getElementById('panel-' + tag).classList.add('active');
      document.getElementById('btn-' + tag).classList.add('active');
    }
  </script>
</head>
<body>
  <div class="container">

    <!-- top-of-report summary card: status, timing, and at-a-glance run info -->
    <div class="summary-card">
      <div class="summary-top">
        <div>
          <h1>{{ manifest.run_id }}<span class="badge {{ status_class }}">{{ manifest.status }}</span></h1>
          <div class="meta">
            {{ manifest.started_at.strftime("%Y-%m-%d %H:%M:%S UTC") }}
            {% if total_elapsed %} · {{ total_elapsed }}{% endif %}
            {% if simulation_duration %} · simulation {{ simulation_duration }}{% endif %}
            {% if imaging_duration %} · imaging {{ imaging_duration }}{% endif %}
            {% if disk_usage %} · {{ disk_usage }} on disk{% endif %}
          </div>
          {% if manifest.config.title %}
          <div class="summary-title">{{ manifest.config.title }}</div>
          {% endif %}
          {% if manifest.config.description %}
          <div class="summary-description">{{ manifest.config.description }}</div>
          {% endif %}
        </div>
        {% if report_warnings %}
        <div class="summary-status-chip chip-warn">⚠ {{ report_warnings | length }} issue{{ "s" if report_warnings | length != 1 else "" }}</div>
        {% else %}
        <div class="summary-status-chip chip-ok">✓ No issues</div>
        {% endif %}
      </div>

      <div class="summary-stats">
        <div>
          <div class="summary-stat-label">Telescope</div>
          <div class="summary-stat-value">
            {{ manifest.config.telescope }}{% if observation_summary.central_frequency_mhz %} · {{ observation_summary.central_frequency_mhz }} MHz{% endif %}
          </div>
        </div>
        {% if imagers_used %}
        <div>
          <div class="summary-stat-label">Imager{{ "s" if imagers_used | length != 1 else "" }}</div>
          <div class="summary-stat-value">{{ imagers_used | join(", ") }}</div>
        </div>
        {% endif %}
        {% if sky_model_summary %}
        <div>
          <div class="summary-stat-label">Sky Model</div>
          <div class="summary-stat-value">
            {% for entry in sky_model_summary %}<span class="badge {{ entry.color }}">{{ entry.label }}</span>{% endfor %}
          </div>
        </div>
        {% endif %}
      </div>

      {% if invocation_command %}
      <div class="summary-invocation">
        <code>{{ invocation_command }}</code>
      </div>
      {% endif %}

      <!-- Run-level warnings: failed milestones, geometry, and phase-centre checks -->
      {% if report_warnings %}
      <div class="warning-banner">
        <div class="warning-title">⚠ {{ report_warnings | length }} issue{{ "s" if report_warnings | length != 1 else "" }} to review</div>
        <ul>
          {% for warning in report_warnings %}
          <li>{{ warning }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>

    <!-- Observation configuration -->
    <h2>Observation & Telescope</h2>
    <div class="config-row">
      <table>
        <tr><th>Telescope</th><td>{{ manifest.config.telescope }} {% if manifest.config.telescope_version %}({{ manifest.config.telescope_version }}){% endif %}</td></tr>
        {% if dish_diameter %}
        <tr><th>Dish Diameter</th><td>{{ dish_diameter }}</td></tr>
        {% endif %}
        {% if n_stations %}
        <tr><th>Antennas</th><td>{{ n_stations }}</td></tr>
        {% endif %}
        {% if maximum_baseline %}
        <tr><th>Maximum Baseline</th><td>{{ maximum_baseline }}</td></tr>
        {% endif %}
        {% if derived_fov %}
        <tr><th>Beam FoV (FWHM)</th><td>{{ derived_fov }} <span style="color:var(--muted); font-size:0.75rem; font-style:italic;">(diffraction limit: 1.25 &lambda;/D)</span></td></tr>
        {% endif %}
        <tr><th>Frequency Range</th><td>{{ observation_summary.band_edge_min_mhz }}-{{ observation_summary.band_edge_max_mhz }} MHz</td></tr>
        <tr><th>Central Frequency</th><td>{{ observation_summary.central_frequency_mhz }} MHz</td></tr>
        <tr><th>Channels</th><td>{{ observation_summary.n_channels }} x {{ observation_summary.channel_bandwidth_mhz }} MHz</td></tr>
        <tr><th>Total Bandwidth</th><td>{{ observation_summary.total_bandwidth_mhz }} MHz</td></tr>
        <tr><th>Obs Time</th><td>{{ observation_summary.observation_time_s }} s</td></tr>
        {% if observation_summary.start_time_utc %}
        <tr><th>Observation Start</th><td>{{ observation_summary.start_time_utc }} UTC</td></tr>
        {% endif %}
        {% if observation_summary.n_timesteps %}
        <tr><th>Timesteps</th><td>{{ observation_summary.n_timesteps }}</td></tr>
        {% endif %}
        {% if observation_summary.integration_time_s %}
        <tr><th>Integration</th><td>{{ observation_summary.integration_time_s }} s</td></tr>
        {% endif %}
        {% if noise_summary.enabled %}
        <tr><th>Noise</th><td>Enabled — {{ noise_summary.detail }}</td></tr>
        {% endif %}
      </table>
      {% if telescope_plot %}
      <div class="plot-container">
        <div class="plot-title">Telescope Layout</div>
        <a href="{{ telescope_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ telescope_plot.data }}" alt="Telescope layout">
        </a>
      </div>
      {% endif %}
      {% if uv_coverage_plot %}
      <div class="plot-container">
        <div class="plot-title">UV Coverage</div>
        <a href="{{ uv_coverage_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ uv_coverage_plot.data }}" alt="UV coverage">
        </a>
      </div>
      {% endif %}
    </div>


    <!-- Sky Model configuration -->
    {% set sky_ms = manifest.milestones | selectattr("name", "equalto", "sky_model_loaded") | list | first | default(none) %}
    {% if (sky_ms and sky_ms.details) or fits_model_plots or sky_model_summary %}
    <h2>Sky Model</h2>
    <div class="config-row">
      <table>
        {% if sky_model_summary %}
        <tr><th>Inputs</th><td>
          {% for entry in sky_model_summary %}
            <span class="badge {{ entry.color }}" style="margin-right:0.3rem;">{{ entry.label }}</span>
            {%- if entry.source %} <code style="font-size:0.75rem;">{{ entry.source }}</code>{% endif %}
            {%- if entry.n_sources %} · {{ entry.n_sources }} sources{% endif %}
            {%- if entry.nterms %} · nterms={{ entry.nterms }}{% endif %}
            {%- if entry.ref_freq_hz %} · ref={{ (entry.ref_freq_hz / 1e6) | round(1) }} MHz{% endif %}
            {%- if entry.stokes %} · {{ entry.stokes | join(', ') }}{% endif %}
            {%- if entry.n_channels %} · {{ entry.n_channels }} channels{% endif %}
            {%- if entry.central_frequency_mhz %} · {{ entry.central_frequency_mhz | round(4) }} MHz{% endif %}
            {%- if entry.channel_width_khz %} · {{ entry.channel_width_khz | round(3) }} kHz/ch{% endif %}
            {%- if entry.spatial_shape %} · {{ entry.spatial_shape[0] }}×{{ entry.spatial_shape[1] }}{% endif %}
            {%- if entry.reference %} · ref={{ entry.reference }}{% endif %}
            {%- if entry.flux_range %} · flux {{ entry.flux_range }}{% endif %}
            {%- if entry.polarization_label %} · {{ entry.polarization_label }}{% endif %}
            <br>
          {% endfor %}
        </td></tr>
        <tr><th>Coordinate Frame</th><td>ICRS (J2000)</td></tr>
        {% elif sky_ms and sky_ms.details %}
        <tr><th>Format</th><td>{{ sky_ms.details.get("format", "?") }}</td></tr>
        <tr><th>Sources</th><td>{{ sky_ms.details.get("n_sources", "?") }} sources</td></tr>
        {% if sky_ms.details.get("model_entries") %}
        <tr><th>Model Entries</th><td>{{ sky_ms.details.get("model_entries") }}</td></tr>
        {% endif %}
        {% if sky_ms.details.get("path") %}
        <tr><th>Path</th><td style="word-break: break-all; font-size: 0.78rem; font-family: monospace;">{{ sky_ms.details.get("path") }}</td></tr>
        {% endif %}
        <tr><th>Coordinate Frame</th><td>ICRS (J2000)</td></tr>
        {% endif %}
        {% for plot in fits_model_plots %}
        <tr>
          <th>Footprint{% if fits_model_plots|length > 1 %} ({{ loop.index }}){% endif %}</th>
          <td>
            {%- if plot.image_size %}{{ plot.image_size[0] }} × {{ plot.image_size[1] }} px{% endif -%}
            {%- if plot.pixel_scale_arcsec is not none %} · {{ plot.pixel_scale_arcsec | round(3) }}″/px{% endif -%}
            {%- if plot.extent_width_deg is not none and plot.extent_height_deg is not none %} · {{ (plot.extent_width_deg * 3600) | round(1) }}″ × {{ (plot.extent_height_deg * 3600) | round(1) }}″{% endif %}
            {% if plot.center_ra_deg is not none and plot.center_dec_deg is not none %}<br>Center: {{ plot.center_ra_deg | round(5) }}°, {{ plot.center_dec_deg | round(5) }}°{% endif -%}
            {%- if plot.offset_from_center_arcsec is not none %} · {{ plot.offset_from_center_arcsec | round(2) }}″ from phase centre{% endif %}
            {% if plot.fov_fraction is not none %}<br>{{ (plot.fov_fraction * 100) | round(1) }}% of FoV{% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
      {% for plot in fits_model_plots %}
      <div class="plot-container">
        <div class="plot-title">Natural Extent — FoV Context{% if fits_model_plots|length > 1 %} ({{ loop.index }}){% endif %}</div>
        <a href="{{ plot.path }}" target="_blank" rel="noopener">
          <img src="{{ plot.data }}" alt="FITS model preview">
        </a>
      </div>
      {% endfor %}
      {% if input_cube_moment8_plot %}
      <div class="plot-container">
        <div class="plot-title">Input spectral cube — Moment 8 (peak)</div>
        <a href="{{ input_cube_moment8_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ input_cube_moment8_plot.data }}" alt="Input cube moment 8 preview">
        </a>
      </div>
      {% endif %}
      {% if sky_model_plot %}
      <div class="plot-container">
        <div class="plot-title">Full Sky Model</div>
        <a href="{{ sky_model_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ sky_model_plot.data }}" alt="Full sky model representation">
        </a>
      </div>
      {% endif %}
      {% if sky_model_fov_plot %}
      <div class="plot-container">
        <div class="plot-title">Sky Model (FoV Zoom)</div>
        <a href="{{ sky_model_fov_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ sky_model_fov_plot.data }}" alt="Sky model FoV zoomed representation">
        </a>
      </div>
      {% endif %}
    </div>
    {% if sky_composition %}
    <div class="composition">
      <div>
        <div class="section-label">Sky composition</div>
        <table class="composition-table">
          <thead>
            <tr>
              <th>Component</th><th>Source</th><th class="num">Offset</th><th>Placement</th>
              <th class="num">Intrinsic ({{ sky_composition.flux_unit }})</th><th class="num">In beam ({{ sky_composition.flux_unit }})</th><th class="num">Beam loss</th>
            </tr>
          </thead>
          <tbody>
          {% for row in sky_composition.rows %}
            <tr>
              <td><span class="badge {{ row.color }}">{{ row.component }}</span>{% if row.type %} {{ row.type }}{% endif %}</td>
              <td class="src">{{ row.source }}</td>
              <td class="num">{{ row.offset }}</td>
              <td>{{ row.placement }}</td>
              <td class="num">{{ row.intrinsic_text }}</td>
              <td class="num">{{ row.attenuated_text }}</td>
              <td class="num">{% if row.attenuation_pct is not none %}{{ "%.1f" | format(row.attenuation_pct) }}%{% else %}—{% endif %}{% if row.beyond_half_power %}<span class="flag" title="Footprint extends beyond the beam half-power radius">▲</span>{% endif %}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        <dl class="composition-notes">
          {% if sky_composition.phase_centre %}<dt>Phase centre</dt><dd>{{ sky_composition.phase_centre }} · {{ sky_composition.phase_centre_rule }}</dd>{% endif %}
          {% if sky_composition.beam_power_fwhm_arcmin is not none %}<dt>Beam</dt><dd>Gaussian (OSKAR station beam), power FWHM {{ "%.2f" | format(sky_composition.beam_power_fwhm_arcmin) }}′{% if sky_composition.ref_freq_mhz %} at {{ "%.1f" | format(sky_composition.ref_freq_mhz) }} MHz{% endif %}</dd>{% endif %}
          {% if sky_composition.ref_freq_mhz %}<dt>Fluxes</dt><dd>Stokes I at {{ "%.1f" | format(sky_composition.ref_freq_mhz) }} MHz; images are merged into DATA one at a time{% if sky_composition.n_merges %} ({{ sky_composition.n_merges }} merges){% endif %}</dd>{% endif %}
          {% if sky_composition.model_data_last_entry_only %}<dt>MODEL_DATA</dt><dd>holds only the last image model's prediction; DATA holds every component</dd>{% endif %}
        </dl>
      </div>
      {% if sky_composition_plot %}
      <div>
        <div class="section-label">Combined view</div>
        <a href="{{ sky_composition_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ sky_composition_plot.data }}" alt="Combined sky composition around the phase centre">
        </a>
      </div>
      {% endif %}
    </div>
    {% endif %}
    {% endif %}

    <!-- Science Products -->
    {% if imaging_tabs %}
    <h2>Imaging Products</h2>
    {% if imaging_tabs | length > 1 %}
    <div class="tab-buttons">
      {% for tab in imaging_tabs %}
      <button id="btn-{{ tab.tag }}" class="tab-button{% if loop.first %} active{% endif %}" onclick="showTab('{{ tab.tag }}')">{{ tab.tag }}</button>
      {% endfor %}
    </div>
    {% endif %}
    {% for tab in imaging_tabs %}
    <div id="panel-{{ tab.tag }}" class="tab-panel{% if loop.first %} active{% endif %}{% if imaging_tabs | length == 1 %} active{% endif %}">
      {% for product in tab.products %}
      <div style="margin-bottom: 2rem;">
        <div style="font-size: 0.9rem; margin-bottom: 0.4rem;">
          <strong>{{ product.product_id }}</strong>
          <span class="badge running">{{ product.imager }}</span>
        </div>
        {% if product.stats %}
        <div class="stats-line">
          Peak: {{ product.stats.peak }} · RMS: {{ product.stats.rms }}{% if product.stats.snr %} · SNR: {{ product.stats.snr }}{% endif %}
          {% if product.beam %} · Beam: {{ product.beam.bmaj or "?" }} x {{ product.beam.bmin or "?" }}{% if product.beam.bpa %} · BPA {{ product.beam.bpa }}{% endif %}{% endif %}
        </div>
        {% elif product.beam %}
        <div class="stats-line">
          Beam: {{ product.beam.bmaj or "?" }} x {{ product.beam.bmin or "?" }}{% if product.beam.bpa %} · BPA {{ product.beam.bpa }}{% endif %}
        </div>
        {% endif %}
        <div class="science-grid">
          {% if product.model or product.clean or product.residual %}
          {% for item, caption in [(product.clean, "Clean"), (product.model, "Model"), (product.residual, "Residual")] %}
          <figure>
            {% if item and item.preview and item.data %}
              <a href="{{ item.preview }}" target="_blank" rel="noopener"><img src="{{ item.data }}" alt="{{ caption }}"></a>
              <figcaption>{{ caption }}</figcaption>
            {% else %}
              <figcaption style="padding: 3rem 0;">{{ caption }} — not available</figcaption>
            {% endif %}
          </figure>
          {% endfor %}
          {% elif product.dirty %}
          <figure>
            {% if product.dirty.preview and product.dirty.data %}
              <a href="{{ product.dirty.preview }}" target="_blank" rel="noopener"><img src="{{ product.dirty.data }}" alt="Dirty"></a>
              <figcaption>Dirty Image</figcaption>
            {% else %}
              <figcaption style="padding: 3rem 0;">Dirty Image — not available</figcaption>
            {% endif %}
          </figure>
          {% endif %}
          {% if product.moment8 %}
          <figure>
            {% if product.moment8.preview and product.moment8.data %}
              <a href="{{ product.moment8.preview }}" target="_blank" rel="noopener"><img src="{{ product.moment8.data }}" alt="Moment 8"></a>
              <figcaption>Moment 8 (peak)</figcaption>
            {% else %}
              <figcaption style="padding: 3rem 0;">Moment 8 — not available</figcaption>
            {% endif %}
          </figure>
          {% endif %}
          {% if product.avg_spectrum %}
          <figure>
            {% if product.avg_spectrum.data %}
              <a href="{{ product.avg_spectrum.path }}" target="_blank" rel="noopener"><img src="{{ product.avg_spectrum.data }}" alt="Average spectrum"></a>
              <figcaption>Average spectrum</figcaption>
            {% else %}
              <figcaption style="padding: 3rem 0;">Average spectrum — not available</figcaption>
            {% endif %}
          </figure>
          {% endif %}
        </div>
        {% if product.psf and product.psf.preview and product.psf.data %}
        <div class="psf-profile">
          <div class="section-label">Point Spread Function</div>
          <div class="psf-layout">
            <div class="plot-container">
              <a href="{{ product.psf.preview }}" target="_blank" rel="noopener">
                <img src="{{ product.psf.data }}" alt="PSF x/y profile through the peak">
              </a>
            </div>
            <div class="psf-metrics">
              <table>
                <tr><th>BMAJ</th><td>{{ product.beam.bmaj if product.beam and product.beam.bmaj else "—" }}</td></tr>
                <tr><th>BMIN</th><td>{{ product.beam.bmin if product.beam and product.beam.bmin else "—" }}</td></tr>
                <tr><th>BPA</th><td>{{ product.beam.bpa if product.beam and product.beam.bpa else "—" }}</td></tr>
                <tr><th>Peak</th><td>{{ "%.4g" | format(product.psf.peak) if product.psf.peak is not none else "—" }}</td></tr>
                <tr><th>Pixel scale</th><td>{{ "%.4g\"" | format(product.psf.pixel_scale_arcsec) if product.psf.pixel_scale_arcsec is not none else "—" }}</td></tr>
              </table>
            </div>
          </div>
        </div>
        {% endif %}
      </div>
      {% endfor %}
      <div class="info-grid" style="margin-top: 1.5rem;">
        <table>
          <tr><th>Resolved Geometry</th><td>{{ tab.imaging_summary.image_size or "?" }} px{% if tab.imaging_summary.pixel_size_arcsec %} · {{ tab.imaging_summary.pixel_size_arcsec }}″/px{% endif %}{% if tab.imaging_summary.fov_deg %} · {{ tab.imaging_summary.fov_deg }}° FoV{% endif %}</td></tr>
          {% if tab.imaging_summary.requested_geometry %}
          {% set rg = tab.imaging_summary.requested_geometry %}
          <tr><th>Requested Geometry</th><td>
            {% if rg.requested_fov_deg is not none %}{{ rg.requested_fov_deg }}° FoV · {% endif %}
            {% if rg.requested_pixels is not none %}{{ rg.requested_pixels }} px · {% endif %}
            {% if rg.requested_cell_size_arcsec is not none %}{{ rg.requested_cell_size_arcsec }}″/px{% endif %}
            {% if rg.requested_fov_deg is none and rg.requested_pixels is none and rg.requested_cell_size_arcsec is none %}none{% endif %}
            {% set geometry_notes = [] %}
            {% if rg.pixels_rounded_up %}{% set _ = geometry_notes.append("rounded to power of two") %}{% endif %}
            {% if rg.legacy_fallback %}{% set _ = geometry_notes.append("legacy fallback") %}{% endif %}
            {% if rg.warnings %}{% for w in rg.warnings %}{% set _ = geometry_notes.append(w) %}{% endfor %}{% endif %}
            {% if geometry_notes %}
            <span style="color:var(--muted); font-size:0.78rem;">({{ geometry_notes | join(" · ") }})</span>
            {% endif %}
          </td></tr>
          {% endif %}
          {% if tab.imaging_summary.theoretical_beam_arcsec %}
          <tr><th>Theoretical Beam</th><td>{{ tab.imaging_summary.theoretical_beam_arcsec }} arcsec {% if tab.imaging_summary.reference_frequency_mhz %}@ {{ tab.imaging_summary.reference_frequency_mhz }} MHz{% endif %} ({{ tab.imaging_summary.requested_geometry.reference_frequency_label or "upper band edge" }}){% if tab.imaging_summary.pixels_per_beam %} <span style="color:var(--muted); font-size:0.78rem;">({{ tab.imaging_summary.pixels_per_beam }} pixels/beam)</span>{% endif %}</td></tr>
          {% endif %}
          {% if tab.imaging_summary.beam %}
          <tr>
            <th>{% if tab.imaging_summary.theoretical_beam_arcsec %}Achieved Beam{% else %}Beam{% endif %}</th>
            <td>
              {{ tab.imaging_summary.beam }}
              {% if tab.imaging_summary.beam_vs_theoretical %}
              <span style="color:var(--muted); font-size:0.78rem;">({{ tab.imaging_summary.beam_vs_theoretical }})</span>
              {% endif %}
            </td>
          </tr>
          {% endif %}
          {% for label, value in tab.imager_parameter_rows %}
          <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
          {% endfor %}
        </table>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    <!-- Timeline -->
    <h2>Timeline</h2>
    <table class="timeline">
      <thead><tr><th>Time</th><th>Event</th><th>Duration</th><th>Details</th></tr></thead>
      <tbody>
        {% for row in timeline_rows %}
        <tr>
          <td style="white-space:nowrap;">{{ row.time }}</td>
          <td><span class="dot dot-{{ row.status }}"></span>{{ row.name }}</td>
          <td>{% if row.duration %}{{ row.duration }}{% endif %}</td>
          <td style="color: var(--muted); font-size: 0.78rem;">{{ row.detail }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <!-- Supporting Plots removed from main page -->

    <!-- Collapsible detail sections -->
    {% if manifest.outputs %}
    <details>
      <summary>Output Records</summary>
      <table>
        <thead><tr><th>Kind</th><th>Path</th><th>Imager</th><th>Role</th></tr></thead>
        <tbody>
          {% for output in manifest.outputs %}
          <tr>
            <td>{{ output.kind }}</td>
            <td>{{ output.path }}</td>
            <td>{{ output.imager or "" }}</td>
            <td>{{ output.role or "" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    {% endif %}

    <h2>Software Versions</h2>
    <table class="timeline">
      <tbody>
        {% for name, value in software_versions %}
        <tr>
          <th style="text-align:left; color:var(--muted); font-weight:500; padding:0.3rem 0.5rem; width:140px;">{{ name }}</th>
          <td style="padding:0.3rem 0.5rem; font-variant-numeric:tabular-nums;">{{ value }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <details>
      <summary>Resolved Configuration</summary>
      <pre>{{ manifest.config.model_dump_json(indent=2) }}</pre>
    </details>

    {% if manifest.errors %}
    <h2 style="color: var(--danger);">Errors</h2>
    {% for err in manifest.errors %}
    <pre style="background:#fff0f0; padding:1rem; border-radius:6px; font-size:0.82rem; color:var(--danger); margin-bottom:0.5rem;">{{ err }}</pre>
    {% endfor %}
    {% endif %}

  </div>
</body>
</html>
